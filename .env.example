# Copy this file to .env and fill in your own values. .env is gitignored.

# Generate at https://dev-portal.onshape.com/keys
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# Onshape's Enterprise/on-prem accounts may need a different host; keep the
# /api/v6 suffix unless your account's API Explorer shows a different version.
ONSHAPE_BASE_URL=https://cad.onshape.com/api/v6

# Generate at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
